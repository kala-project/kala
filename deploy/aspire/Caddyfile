{
	admin off
	servers {
		metrics
	}
}

{$KALA_PUBLIC_HOSTNAME} {
	encode zstd gzip
	@silo path /silo /silo/*
	handle @silo {
		redir /silo /silo/ 308
		route {
			forward_auth gateway:13001 {
				uri /auth/silo/authorize
			}
			uri strip_prefix /silo
			reverse_proxy silo:9001 {
				header_up Cookie "(^|;[[:space:]]*)ak_session=[^;]*(;[[:space:]]*)?" "$1"
				stream_timeout 5m
			}
		}
	}
	handle {
		reverse_proxy gateway:13001
	}
}

# Container-local liveness only; never published and never bypasses public TLS.
http://127.0.0.1:8081 {
	respond /healthz "ok" 200
}

# Private Compose network only; no host publication, admin API or per-host labels.
http://:8082 {
	metrics /metrics
}
