KALA_PROFILE=local
KALA_STORAGE=postgres-s3
KALA_IDENTITY_MODE=external
COMPOSE_PROJECT_NAME=kala-private-cloud-pg-s3-eval-CHANGE_ME
KALA_PG_S3_EVALUATION_ACK=1
KALA_PG_S3_EXTERNAL_BACKUP_ACK=1
KALA_CONTROL_DML_ROLE=kala_control_writer
KALA_RUNTIME_DML_ROLE=kala_runtime_writer
KALA_RUNTIME_READER_ROLE=kala_runtime_reader
KALA_S3_ENDPOINT=https://<s3-domain>
KALA_S3_REGION=<region>
KALA_S3_BUCKET=<bucket>
KALA_PUBLIC_URLS=http://localhost:13001
OIDC_ISSUER=https://<identity-domain>
OIDC_DISCOVERY_ORIGIN=https://<identity-domain>
KALA_PUBLIC_LISTEN=127.0.0.1:13001
KALA_RUNTIME_UNIT_MAX_CONCURRENT_TURNS=4
KALA_RUNTIME_UNIT_MAX_QUEUED_MESSAGES=100
KALA_RUNTIME_UNIT_MAX_ARTIFACT_BYTES=10737418240
KALA_INGRESS_MAX_SERVICE_ACCOUNTS=100
