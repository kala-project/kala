{
  "name": "@agent-kernel/substrate",
  "version": "0.4.1",
  "description": "Self-improvement substrate: run a meta-agent auto-evolve loop over an agent's harness, judged by an out-of-loop evaluator. Sits entirely above the host's public API.",
  "repository": { "type": "git", "url": "git+https://github.com/xingsy97/kala.git" },
  "homepage": "https://github.com/xingsy97/kala#readme",
  "bugs": { "url": "https://github.com/xingsy97/kala/issues" },
  "type": "module",
  "main": "./dist/substrate/src/index.js",
  "types": "./dist/substrate/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/substrate/src/index.d.ts",
      "import": "./dist/substrate/src/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/dist/**'",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-kernel/host": "workspace:*",
    "@agent-kernel/kernel": "workspace:*",
    "@agent-kernel/shared": "workspace:*",
    "ulid": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  },
  "sideEffects": false,
  "license": "MIT"
}
