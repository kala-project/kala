{
  "name": "@agent-kernel/shared",
  "version": "0.3.2",
  "description": "Shared protocol types between core, executor, and dashboard.",
  "repository": { "type": "git", "url": "git+https://github.com/xingsy97/kala.git" },
  "homepage": "https://github.com/xingsy97/kala#readme",
  "bugs": { "url": "https://github.com/xingsy97/kala/issues" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./enhancement": {
      "types": "./dist/enhancement.d.ts",
      "import": "./dist/enhancement.js"
    },
    "./token-estimation": {
      "types": "./dist/token-estimation.d.ts",
      "import": "./dist/token-estimation.js"
    },
    "./session-derived-state": {
      "types": "./dist/session-derived-state.d.ts",
      "import": "./dist/session-derived-state.js"
    },
    "./context-usage": {
      "types": "./dist/context-usage/index.d.ts",
      "import": "./dist/context-usage/index.js"
    },
    "./context-policy": {
      "types": "./dist/context-policy/index.d.ts",
      "import": "./dist/context-policy/index.js"
    },
    "./human-attention": {
      "types": "./dist/human-attention/index.d.ts",
      "import": "./dist/human-attention/index.js"
    },
    "./push": {
      "types": "./dist/push.d.ts",
      "import": "./dist/push.js"
    },
    "./workspace-exec": {
      "types": "./dist/workspace-exec.d.ts",
      "import": "./dist/workspace-exec.js"
    },
    "./secret-resolver": {
      "types": "./dist/secret-resolver.d.ts",
      "import": "./dist/secret-resolver.js"
    },
    "./runtime-logger": {
      "types": "./dist/runtime-logger.d.ts",
      "import": "./dist/runtime-logger.js"
    },
    "./node-telemetry": {
      "types": "./dist/node-telemetry.d.ts",
      "import": "./dist/node-telemetry.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/dist/**'",
    "typecheck": "tsc --noEmit",
    "publish:npm": "pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "dependencies": {
    "@agent-kernel/kernel": "workspace:*",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  },
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
