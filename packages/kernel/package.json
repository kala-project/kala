{
  "name": "@agent-kernel/kernel",
  "version": "0.3.0",
  "description": "Pure-function reducer kernel for coding agents. Zero dependencies. < 500 lines.",
  "repository": { "type": "git", "url": "git+https://github.com/xingsy97/kala.git" },
  "homepage": "https://github.com/xingsy97/kala#readme",
  "bugs": { "url": "https://github.com/xingsy97/kala/issues" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/dist/**'",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "publish:npm": "pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "dependencies": {},
  "devDependencies": {
    "fast-check": "4.9.0",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  },
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
