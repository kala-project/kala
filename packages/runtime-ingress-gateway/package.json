{
  "name": "@agent-kernel/runtime-ingress-gateway",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kala-runtime-ingress": "./dist/src/bin/kala-runtime-ingress.js",
    "agent-runlab-control-plane-migrate": "./dist/src/bin/migrate-control-plane.js",
    "agent-runlab-control-plane-import-json": "./dist/src/bin/import-json-control.js",
    "kala-dedicated-owner-bootstrap": "./dist/src/bin/bootstrap-dedicated-owner.js",
    "kala-dedicated-oidc-owner-bootstrap": "./dist/src/bin/bootstrap-dedicated-oidc-owner.js",
    "kala-dedicated-owner-rotate": "./dist/src/bin/rotate-dedicated-owner.js",
    "kala-dedicated-owner-reset": "./dist/src/bin/reset-dedicated-owner.js",
    "kala-webhook-worker": "./dist/src/bin/webhook-worker.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/dist/**'",
    "migrate": "node dist/src/bin/migrate-control-plane.js",
    "import:json": "node dist/src/bin/import-json-control.js",
    "bootstrap:dedicated-owner": "node dist/src/bin/bootstrap-dedicated-owner.js",
    "bootstrap:dedicated-oidc-owner": "node dist/src/bin/bootstrap-dedicated-oidc-owner.js",
    "rotate:dedicated-owner": "node dist/src/bin/rotate-dedicated-owner.js",
    "reset:dedicated-owner": "node dist/src/bin/reset-dedicated-owner.js",
    "webhooks": "node dist/src/bin/webhook-worker.js"
  },
  "dependencies": {
    "@agent-kernel/shared": "workspace:*",
    "http-proxy": "1.18.1",
    "openid-client": "6.8.1",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/http-proxy": "1.17.16",
    "@types/node": "22.9.0",
    "@types/pg": "8.20.0",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  }
}
