{
  "name": "@agent-kernel/eval-dashboard",
  "version": "0.4.1",
  "description": "Standalone production Web UI for the Agent Evaluation Platform.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/dist/**'"
  },
  "dependencies": {
    "@agent-kernel/eval-protocol": "workspace:*",
    "@agent-kernel/eval-sdk": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.0.1",
    "@types/node": "22.20.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.4.1",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  },
  "sideEffects": false,
  "license": "MIT"
}
