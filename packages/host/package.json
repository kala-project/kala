{
  "name": "@agent-kernel/host",
  "version": "0.3.0-beta.19",
  "description": "Kala Host runtime: model adapters, session store, and Socket.IO server.",
  "repository": { "type": "git", "url": "git+https://github.com/xingsy97/kala.git" },
  "homepage": "https://github.com/xingsy97/kala#readme",
  "bugs": { "url": "https://github.com/xingsy97/kala/issues" },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "kala-host": "./dist/bin/kala-host.js",
    "kala-runtime-service": "./dist/bin/kala-runtime-service.js",
    "kala-postgres-migrate": "./dist/bin/kala-postgres-migrate.js",
    "kala-parallel-placement": "./dist/bin/kala-parallel-placement.js",
    "kala-fresh-storage-claim": "./dist/bin/kala-fresh-storage-claim.js",
    "kala-dedicated-ingress": "./dist/bin/kala-dedicated-ingress.js",
    "kala-dedicated-deploy-supervisor": "./dist/bin/kala-dedicated-deploy-supervisor.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/dist/**'",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --exclude \"../dashboard/**\" bin/kala-host.ts",
    "dev:restart": "node ../../scripts/dev/restart-every.mjs --interval-ms 180000 -- tsx bin/kala-host.ts",
    "publish:npm": "pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "dependencies": {
    "@agent-kernel/executor": "workspace:*",
    "@agent-kernel/kernel": "workspace:*",
    "@agent-kernel/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1098.0",
    "@aws-sdk/s3-request-presigner": "3.1098.0",
    "@github/copilot-sdk": "1.0.14",
    "@socket.io/admin-ui": "0.5.1",
    "bcryptjs": "2.4.3",
    "eventsource-parser": "3.1.0",
    "fflate": "0.8.3",
    "http-proxy": "1.18.1",
    "jsonc-parser": "3.3.1",
    "p-retry": "8.0.0",
    "pg": "8.22.0",
    "socket.io": "4.8.4",
    "ulid": "2.3.0",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/http-proxy": "1.17.17",
    "@types/node": "22.9.0",
    "@types/web-push": "3.6.4",
    "fast-check": "4.9.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
