exports[`wire contract — schema surface > pins authoritative session timing on both Dashboard baseline schemas 1`] = `
{
  "sessionReady": [
    "agentRuntime",
    "agentRuntimeCapabilities",
    "agentType",
    "compactStatus",
    "config",
    "contextSnapshot",
    "cursor",
    "executionMode",
    "parentCallId",
    "parentCursor",
    "parentSessionId",
    "reason",
    "runtimeCompactionPolicy",
    "selectedModel",
    "sessionId",
    "state",
    "streamingDraft",
    "subAgentStartedAt",
    "turnStartedAt",
    "workspaceId",
    "workspaceName",
  ],
  "stateChanged": [
    "contextSnapshot",
    "cursor",
    "sessionId",
    "state",
    "turnStartedAt",
  ],
}
`;
