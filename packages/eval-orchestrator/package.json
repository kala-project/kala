{
  "name": "@agent-kernel/eval-orchestrator",
  "version": "0.3.4",
  "description": "Standalone durable Control Plane for the Agent Evaluation Platform.",
  "repository": { "type": "git", "url": "git+https://github.com/xingsy97/kala.git" },
  "homepage": "https://github.com/xingsy97/kala#readme",
  "bugs": { "url": "https://github.com/xingsy97/kala/issues" },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "agent-eval-orchestrator": "./dist/bin/eval-orchestrator.js",
    "agent-eval": "./dist/bin/eval-cli.js",
    "agent-eval-ci": "./dist/bin/eval-ci.js"
  },
  "files": ["dist", "src", "bin", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/dist/**'",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch bin/eval-orchestrator.ts"
  },
  "dependencies": {
    "@agent-kernel/eval-protocol": "workspace:*",
    "@agent-kernel/eval-sdk": "workspace:*",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  },
  "sideEffects": false,
  "license": "MIT"
}
