{
  "name": "@agent-kernel/dashboard",
  "version": "0.3.4",
  "description": "Kala Dashboard: React app that subscribes to the Kala Host over Socket.IO.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prototype": "vite --config vite.prototype.config.ts --host 0.0.0.0 --port 4179",
    "build": "node scripts/build.mjs",
    "build:prototype": "node scripts/build.mjs --prototype",
    "verify:prototype": "node scripts/prototype-interaction.mjs",
    "verify:style": "node scripts/style-browser.mjs",
    "preview": "vite preview",
    "test": "vitest run && node --test --test-concurrency=1 scripts/style-rules.test.mjs scripts/splash-theme.test.mjs scripts/pwa-network-shell.test.mjs scripts/monaco-self-hosting.test.mjs scripts/desktop-download.test.mjs scripts/build-budget.test.mjs scripts/monaco-worker-build.test.mjs scripts/lazy-feature-build.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:style": "node scripts/lint-style.mjs",
    "verify:real": "node ../../scripts/dashboard/verify-dashboard-real.mjs",
    "verify:debugger": "node ../../scripts/dashboard/verify-dashboard-debugger.mjs",
    "verify:layout-scroll": "node ../../scripts/dashboard/verify-dashboard-layout-scroll.mjs",
    "verify:mobile-pwa": "node ../../scripts/dashboard/verify-dashboard-mobile-pwa.mjs",
    "verify:subagent-scroll": "node ../../scripts/dashboard/verify-dashboard-subagent-scroll.mjs",
    "verify:sidebar-layout": "node ../../scripts/dashboard/verify-sidebar-layout-matrix.mjs"
  },
  "dependencies": {
    "@agent-kernel/kernel": "workspace:*",
    "@agent-kernel/shared": "workspace:*",
    "@formkit/auto-animate": "0.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@radix-ui/react-alert-dialog": "1.1.18",
