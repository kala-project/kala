{
  "name": "@agent-kernel/executor",
  "version": "0.3.0-beta.19",
  "description": "Kala workspace executor: sandboxed tool runner that connects to the Kala Host.",
  "repository": { "type": "git", "url": "git+https://github.com/xingsy97/kala.git" },
  "homepage": "https://github.com/xingsy97/kala#readme",
  "bugs": { "url": "https://github.com/xingsy97/kala/issues" },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "kala-executor": "./dist/bin/kala-executor.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/dist/**'",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch bin/kala-executor.ts",
    "dev:restart": "node ../../scripts/dev/restart-every.mjs --interval-ms 180000 -- tsx bin/kala-executor.ts",
    "publish:npm": "pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "dependencies": {
    "@agent-kernel/kernel": "workspace:*",
    "@agent-kernel/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.0",
    "ignore": "7.0.6",
    "node-pty": "1.1.0",
    "picomatch": "4.0.7",
    "proper-lockfile": "4.1.2",
    "puppeteer-core": "25.3.0",
    "socket.io-client": "4.8.4",
    "ulid": "2.3.0",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/picomatch": "3.0.1",
    "@types/proper-lockfile": "4.1.4",
    "socket.io-client": "4.8.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  },
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
