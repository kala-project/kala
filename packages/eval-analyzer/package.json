{
  "name": "@agent-kernel/eval-analyzer",
  "version": "0.3.2",
  "description": "Deterministic defect detection, trace alignment, clustering, and reproduction minimization for the standalone evaluation platform.",
  "repository": { "type": "git", "url": "git+https://github.com/xingsy97/kala.git" },
  "homepage": "https://github.com/xingsy97/kala#readme",
  "bugs": { "url": "https://github.com/xingsy97/kala/issues" },
  "type": "module",
  "main": "./dist/src/index.js",
  "bin": { "agent-eval-validate-detectors": "./dist/bin/validate-detectors.js", "agent-eval-analyzer": "./dist/bin/eval-analyzer.js", "agent-eval-grader": "./dist/bin/eval-grader.js" },
  "types": "./dist/src/index.d.ts",
  "exports": { ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" } },
  "files": ["dist", "src", "bin", "fixtures", "README.md"],
  "scripts": { "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json", "typecheck": "tsc --noEmit", "test": "vitest run --exclude '**/dist/**'" },
  "dependencies": {
    "@agent-kernel/eval-protocol": "workspace:*",
    "@agent-kernel/eval-sdk": "workspace:*"
  },
  "devDependencies": { "@agent-kernel/eval-orchestrator": "workspace:*", "@types/node": "22.9.0", "typescript": "5.6.3", "vitest": "4.1.11" },
  "sideEffects": false,
  "license": "MIT"
}
