# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
/release/
packages/dashboard/dist-prototype/
packages/dashboard/review-screenshots/
packages/website/.generated/
*.woff
*.woff2
*.ttf
*.otf
.tmp/
*.tsbuildinfo
.next/
.turbo/

# Environment
.env
.env.local
.env.*.local
.env.*
!*.env.example
deploy/saas/.secrets/
deploy/saas/**/.secrets/
deploy/saas/.tls/
deploy/saas/backups/
deploy/private-cloud/.secrets/
deploy/private-cloud/**/.secrets/
deploy/private-cloud/.tls/
deploy/private-cloud/backups/
deploy/identity/.secrets/
deploy/identity/backups/
deploy/**/release-manifest.local.json
deploy/**/deployment.env
*.pem
!scripts/release/executor-update-public-key.pem
secrets*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store

# Test / coverage
coverage/
.nyc_output/
__pycache__/
*.py[cod]

# Session data (event logs will land here)
sessions/
.agent-kernel/
.agent-evaluation/

# Reference projects (cloned for study, not committed)
references/
.presq/

# Agent scratch
.claude/
.agent-home/
.claude-home/
.artifacts/
/artifacts/
.chrome-cdp/

# Experiment-local heavy/raw evidence. Small summaries, reports, diagnostics,
# and plans live outside artifacts so gitignore stays simple.
experiments/**/.venv*/
experiments/**/artifacts/

# Defensive ignores for misplaced runtime output.
experiments/**/*.tar
experiments/**/*.tar.gz
experiments/**/workspace/
experiments/**/workspaces/

# Per-package scratch directories (local debug/probe scripts, not committed)
packages/*/scratch/
tmp/

# Optional machine-local privacy denylist. The canonical location is inside
# .git/privacy-denylist; this protects explicit local overrides too.
.privacy-denylist
